import { renderHook, waitFor } from '@testing-library/react';
import { useFilteredTasks } from '@/hooks/useFilteredTasks';
import { createMockSupabaseClient } from '../utils/test-utils';

// Supabaseクライアントをモック
jest.mock('@/lib/supabase', () => ({
  supabase: {
    from: jest.fn(),
    auth: {
      getSession: jest.fn(),
      onAuthStateChange: jest.fn()
    },
    rpc: jest.fn()
  }
}));

const mockSupabaseClient = createMockSupabaseClient();

describe('useFilteredTasks', () => {
  const mockTasks = [
    {
      id: 'task-1',
      text: 'Test Task 1',
      completed: false,
      priority: '高',
      user_id: 'user-1',
      assigned_to: null,
      created_by: 'user-1',
      created_at: '2024-01-01T00:00:00Z',
      updated_at: '2024-01-01T00:00:00Z',
      team_id: null,
      creator_name: 'Test User',
      assignee_name: null,
      owner_name: 'Test User'
    },
    {
      id: 'task-2',
      text: 'Test Task 2',
      completed: true,
      priority: '中',
      user_id: 'user-1',
      assigned_to: 'user-2',
      created_by: 'user-1',
      created_at: '2024-01-02T00:00:00Z',
      updated_at: '2024-01-02T00:00:00Z',
      team_id: 'team-1',
      creator_name: 'Test User',
      assignee_name: 'Assigned User',
      owner_name: 'Test User'
    }
  ];

  beforeEach(() => {
    jest.clearAllMocks();
    
    // デフォルトの成功レスポンス
    const { supabase } = require('@/lib/supabase');
    supabase.rpc.mockResolvedValue({
      data: mockTasks,
      error: null
    });
  });

  describe('Basic functionality', () => {
    it('初期状態で正しくタスクを取得する', async () => {
      const { result } = renderHook(() => useFilteredTasks());

      // 初期ローディング状態
      expect(result.current.loading).toBe(true);
      expect(result.current.tasks).toEqual([]);
      expect(result.current.error).toBeNull();

      // データ取得完了を待つ
      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.tasks).toEqual(mockTasks);
      expect(result.current.error).toBeNull();
    });

    it('フィルターなしでデフォルト値を使用する', async () => {
      const { supabase } = require('@/lib/supabase');
      
      renderHook(() => useFilteredTasks());

      await waitFor(() => {
        expect(supabase.rpc).toHaveBeenCalledWith('get_tasks_with_filters', {
          filter_user_id: null,
          filter_team_id: null,
          search_text: null,
          statuses: null,
          priorities: null,
          assigned_user_id: null,
          created_after: null,
          created_before: null,
          due_after: null,
          due_before: null,
          include_completed: true,
          limit_count: 100,
          offset_count: 0
        });
      });
    });
  });

  describe('Filter options', () => {
    it('ユーザーIDフィルターが正しく適用される', async () => {
      const { supabase } = require('@/lib/supabase');
      const filters = { userId: 'user-123' };
      
      renderHook(() => useFilteredTasks(filters));

      await waitFor(() => {
        expect(supabase.rpc).toHaveBeenCalledWith('get_tasks_with_filters', 
          expect.objectContaining({
            filter_user_id: 'user-123'
          })
        );
      });
    });

    it('チームIDフィルターが正しく適用される', async () => {
      const { supabase } = require('@/lib/supabase');
      const filters = { teamId: 'team-456' };
      
      renderHook(() => useFilteredTasks(filters));

      await waitFor(() => {
        expect(supabase.rpc).toHaveBeenCalledWith('get_tasks_with_filters',
          expect.objectContaining({
            filter_team_id: 'team-456'
          })
        );
      });
    });

    it('検索テキストフィルターが正しく適用される', async () => {
      const { supabase } = require('@/lib/supabase');
      const filters = { searchText: '重要なタスク' };
      
      renderHook(() => useFilteredTasks(filters));

      await waitFor(() => {
        expect(supabase.rpc).toHaveBeenCalledWith('get_tasks_with_filters',
          expect.objectContaining({
            search_text: '重要なタスク'
          })
        );
      });
    });

    it('複数のフィルターが同時に適用される', async () => {
      const { supabase } = require('@/lib/supabase');
      const filters = {
        userId: 'user-123',
        teamId: 'team-456',
        searchText: 'urgent',
        priorities: ['高', '中'],
        includeCompleted: false,
        limit: 50,
        offset: 10
      };
      
      renderHook(() => useFilteredTasks(filters));

      await waitFor(() => {
        expect(supabase.rpc).toHaveBeenCalledWith('get_tasks_with_filters', {
          filter_user_id: 'user-123',
          filter_team_id: 'team-456',
          search_text: 'urgent',
          statuses: null,
          priorities: ['高', '中'],
          assigned_user_id: null,
          created_after: null,
          created_before: null,
          due_after: null,
          due_before: null,
          include_completed: false,
          limit_count: 50,
          offset_count: 10
        });
      });
    });
  });

  describe('Error handling', () => {
    it('Supabaseエラーを適切に処理する', async () => {
      const { supabase } = require('@/lib/supabase');
      const mockError = new Error('Database connection failed');
      
      supabase.rpc.mockResolvedValue({
        data: null,
        error: mockError
      });

      const { result } = renderHook(() => useFilteredTasks());

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.error).toBe('Database connection failed');
      expect(result.current.tasks).toEqual([]);
    });

    it('予期しないエラーを適切に処理する', async () => {
      const { supabase } = require('@/lib/supabase');
      
      supabase.rpc.mockRejectedValue('Network error');

      const { result } = renderHook(() => useFilteredTasks());

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.error).toBe('タスク取得に失敗しました');
      expect(result.current.tasks).toEqual([]);
    });
  });

  describe('Refetch functionality', () => {
    it('refetch関数が正常に動作する', async () => {
      const { supabase } = require('@/lib/supabase');
      const { result } = renderHook(() => useFilteredTasks());

      // 初回の取得を待つ
      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(supabase.rpc).toHaveBeenCalledTimes(1);

      // refetchを実行
      await result.current.refetch();

      expect(supabase.rpc).toHaveBeenCalledTimes(2);
    });
  });

  describe('Filter changes', () => {
    it('フィルター変更時にタスクを再取得する', async () => {
      const { supabase } = require('@/lib/supabase');
      const { result, rerender } = renderHook(
        ({ filters }) => useFilteredTasks(filters),
        {
          initialProps: { filters: { userId: 'user-1' } }
        }
      );

      // 初回取得を待つ
      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(supabase.rpc).toHaveBeenCalledTimes(1);

      // フィルターを変更
      rerender({ filters: { userId: 'user-2' } });

      // 再取得されることを確認
      await waitFor(() => {
        expect(supabase.rpc).toHaveBeenCalledTimes(2);
      });

      expect(supabase.rpc).toHaveBeenLastCalledWith('get_tasks_with_filters',
        expect.objectContaining({
          filter_user_id: 'user-2'
        })
      );
    });
  });
});