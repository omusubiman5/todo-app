import React from 'react';
import { renderHook, waitFor, act } from '@testing-library/react';
import { useOptimizedTasks } from '@/hooks/useOptimizedTasks';
import { createMockTask, createMockUser } from '../utils/test-utils';

// Mock the auth provider
jest.mock('@/components/AuthProvider', () => ({
  useAuth: jest.fn(() => ({
    user: { id: 'test-user-id', email: 'test@example.com' },
    loading: false
  }))
}));

// Mock the workspace provider  
jest.mock('@/components/WorkspaceProvider', () => ({
  useWorkspace: jest.fn(() => ({
    workspace: { type: 'personal', teamId: null },
    switchToPersonal: jest.fn(),
    switchToTeam: jest.fn()
  }))
}));

// Mock the shared task service
jest.mock('@/lib/sharedTaskService', () => ({
  SharedTaskService: {
    fetchTasks: jest.fn(),
    createTask: jest.fn(),
    updateTask: jest.fn(),
    deleteTask: jest.fn(),
    toggleTaskCompletion: jest.fn(),
    getTaskStatistics: jest.fn(),
    subscribeToTasks: jest.fn(() => ({ unsubscribe: jest.fn() }))
  }
}));

// Mock the realtime connection manager
jest.mock('@/lib/RealtimeConnectionManager', () => ({
  RealtimeConnectionManager: {
    getInstance: jest.fn(() => ({
      subscribeToTasks: jest.fn(),
      unsubscribe: jest.fn(),
      unsubscribeFromTasks: jest.fn(),
      updateSubscription: jest.fn()
    }))
  }
}));

describe('useOptimizedTasks', () => {
  let mockTaskService: any;
  let mockRealtimeManager: any;
  const mockUser = createMockUser();
  const mockTasks = [
    createMockTask({ id: '1', text: 'Task 1', completed: false }),
    createMockTask({ id: '2', text: 'Task 2', completed: true }),
    createMockTask({ id: '3', text: 'Task 3', completed: false })
  ];

  beforeEach(() => {
    jest.clearAllMocks();
    mockTaskService = require('@/lib/sharedTaskService').SharedTaskService;
    mockRealtimeManager = require('@/lib/realtimeManager').RealtimeManager.getInstance();

    // Default successful responses
    mockTaskService.fetchTasks.mockResolvedValue(mockTasks);
    mockTaskService.createTask.mockResolvedValue(mockTasks[0]);
    mockTaskService.updateTask.mockResolvedValue(mockTasks[0]);
    mockTaskService.deleteTask.mockResolvedValue(undefined);
    mockTaskService.toggleTaskCompletion.mockResolvedValue({
      ...mockTasks[0],
      completed: !mockTasks[0].completed
    });
    mockTaskService.getTaskStatistics.mockResolvedValue({
      total: 3,
      completed: 1,
      pending: 2,
      high: 1,
      medium: 1,
      low: 1,
      completionRate: 33.33
    });
  });

  describe('初期化', () => {
    it('初期状態が正しく設定される', () => {
      const { result } = renderHook(() =>
        useOptimizedTasks()
      );

      expect(result.current.tasks).toEqual([]);
      expect(result.current.isLoading).toBe(true);
      expect(result.current.error).toBeNull();
    });

    it('タスクが正常に読み込まれる', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.tasks).toEqual(mockTasks);
      expect(mockTaskService.fetchTasks).toHaveBeenCalledWith(mockUser.id, null);
      expect(mockRealtimeManager.subscribeToTasks).toHaveBeenCalled();
    });

    it('読み込みエラーが適切にハンドリングされる', async () => {
      const errorMessage = 'Failed to fetch tasks';
      mockTaskService.fetchTasks.mockRejectedValueOnce(new Error(errorMessage));

      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.error).toBe(errorMessage);
      expect(result.current.tasks).toEqual([]);
    });
  });

  describe('タスク作成', () => {
    it('新しいタスクが正常に作成される', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const newTaskData = {
        text: 'New Task',
        priority: '高' as const,
        user_id: mockUser.id
      };

      const newTask = createMockTask({ id: '4', ...newTaskData });
      mockTaskService.createTask.mockResolvedValueOnce(newTask);

      await act(async () => {
        await result.current.createTask(newTaskData);
      });

      expect(mockTaskService.createTask).toHaveBeenCalledWith(newTaskData, null);
      expect(result.current.tasks).toContainEqual(newTask);
    });

    it('楽観的更新が正しく動作する', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const newTaskData = {
        text: 'Optimistic Task',
        priority: '中' as const,
        user_id: mockUser.id
      };

      // サービス呼び出しを遅延させる
      let resolveCreate: (value: any) => void;
      const createPromise = new Promise(resolve => {
        resolveCreate = resolve;
      });
      mockTaskService.createTask.mockReturnValueOnce(createPromise);

      act(() => {
        result.current.createTask(newTaskData);
      });

      // 楽観的更新により即座にタスクが追加されるはず
      expect(result.current.tasks.some(t => t.text === 'Optimistic Task')).toBe(true);

      // サービス呼び出しを完了
      resolveCreate!(createMockTask({ id: '4', ...newTaskData }));
      await waitFor(() => {
        expect(mockTaskService.createTask).toHaveBeenCalled();
      });
    });

    it('作成失敗時に楽観的更新がロールバックされる', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const initialTasksCount = result.current.tasks.length;
      mockTaskService.createTask.mockRejectedValueOnce(new Error('Creation failed'));

      await act(async () => {
        try {
          await result.current.createTask({
            text: 'Failed Task',
            priority: '中' as const,
            user_id: mockUser.id
          });
        } catch (e) {
          // エラーは期待される
        }
      });

      expect(result.current.tasks).toHaveLength(initialTasksCount);
      expect(result.current.error).toBe('Creation failed');
    });
  });

  describe('タスク更新', () => {
    it('タスクが正常に更新される', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const updatedTask = { ...mockTasks[0], text: 'Updated Task' };
      mockTaskService.updateTask.mockResolvedValueOnce(updatedTask);

      await act(async () => {
        await result.current.updateTask(mockTasks[0].id, { text: 'Updated Task' });
      });

      expect(mockTaskService.updateTask).toHaveBeenCalledWith(
        mockTasks[0].id,
        { text: 'Updated Task' }
      );
      expect(result.current.tasks.find(t => t.id === mockTasks[0].id)?.text)
        .toBe('Updated Task');
    });

    it('完了状態の切り替えが正常に動作する', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const toggledTask = { ...mockTasks[0], completed: true };
      mockTaskService.toggleTaskCompletion.mockResolvedValueOnce(toggledTask);

      await act(async () => {
        await result.current.toggleCompletion(mockTasks[0].id);
      });

      expect(mockTaskService.toggleTaskCompletion).toHaveBeenCalledWith(
        mockTasks[0].id,
        mockTasks[0].completed
      );
      expect(result.current.tasks.find(t => t.id === mockTasks[0].id)?.completed)
        .toBe(true);
    });
  });

  describe('タスク削除', () => {
    it('タスクが正常に削除される', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const taskToDelete = mockTasks[0];
      mockTaskService.deleteTask.mockResolvedValueOnce(undefined);

      await act(async () => {
        await result.current.deleteTask(taskToDelete.id);
      });

      expect(mockTaskService.deleteTask).toHaveBeenCalledWith(taskToDelete.id);
      expect(result.current.tasks.find(t => t.id === taskToDelete.id)).toBeUndefined();
    });

    it('削除失敗時にタスクが復元される', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const taskToDelete = mockTasks[0];
      mockTaskService.deleteTask.mockRejectedValueOnce(new Error('Delete failed'));

      await act(async () => {
        try {
          await result.current.deleteTask(taskToDelete.id);
        } catch (e) {
          // エラーは期待される
        }
      });

      expect(result.current.tasks.find(t => t.id === taskToDelete.id)).toBeDefined();
      expect(result.current.error).toBe('Delete failed');
    });
  });

  describe('フィルタリング', () => {
    it('完了フィルターが正しく動作する', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null, { showCompleted: false })
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      const incompleteTasks = result.current.tasks.filter(t => !t.completed);
      expect(result.current.tasks).toEqual(incompleteTasks);
    });

    it('優先度フィルターが正しく動作する', async () => {
      const highPriorityTasks = [
        createMockTask({ id: '1', priority: '高' }),
        createMockTask({ id: '2', priority: '中' })
      ];
      mockTaskService.fetchTasks.mockResolvedValueOnce(highPriorityTasks);

      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null, { priority: '高' })
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.tasks.every(t => t.priority === '高')).toBe(true);
    });

    it('検索フィルターが正しく動作する', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null, { search: 'Task 1' })
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.tasks.every(t => t.text.includes('Task 1'))).toBe(true);
    });
  });

  describe('統計情報', () => {
    it('統計情報が正常に更新される', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      await act(async () => {
        await result.current.refreshStatistics();
      });

      expect(result.current.statistics).toEqual({
        total: 3,
        completed: 1,
        pending: 2,
        high: 1,
        medium: 1,
        low: 1,
        completionRate: 33.33
      });
    });
  });

  describe('リアルタイム更新', () => {
    it('ワークスペース変更時にリアルタイム購読が更新される', async () => {
      const { result, rerender } = renderHook(
        ({ userId, teamId }) => useOptimizedTasks(userId, teamId),
        { initialProps: { userId: mockUser.id, teamId: null } }
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      // チームワークスペースに変更
      rerender({ userId: mockUser.id, teamId: 'team-123' });

      await waitFor(() => {
        expect(mockRealtimeManager.updateSubscription).toHaveBeenCalledWith(
          mockUser.id,
          'team-123'
        );
      });
    });

    it('アンマウント時にリアルタイム購読が解除される', () => {
      const { unmount } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      unmount();

      expect(mockRealtimeManager.unsubscribeFromTasks).toHaveBeenCalled();
    });
  });

  describe('パフォーマンス', () => {
    it('同一の依存関係で再レンダリングが発生しない', async () => {
      let renderCount = 0;
      const TestComponent = () => {
        renderCount++;
        useOptimizedTasks(mockUser.id, null);
        return null;
      };

      const { rerender } = renderHook(() => { 
        return React.createElement(TestComponent); 
      });

      await waitFor(() => {
        expect(renderCount).toBeGreaterThan(0);
      });

      const initialRenderCount = renderCount;

      // 同じpropsで再レンダリング
      rerender();
      rerender();

      // 追加のレンダリングが発生しないことを確認
      expect(renderCount).toBe(initialRenderCount);
    });

    it('バッチ処理が正しく動作する', async () => {
      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null)
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      // 複数の操作を同時実行
      await act(async () => {
        await Promise.all([
          result.current.updateTask('1', { text: 'Updated 1' }),
          result.current.updateTask('2', { text: 'Updated 2' }),
          result.current.updateTask('3', { text: 'Updated 3' })
        ]);
      });

      // 各操作が個別に呼び出されることを確認
      expect(mockTaskService.updateTask).toHaveBeenCalledTimes(3);
    });
  });

  describe('エラー処理', () => {
    it('リトライ機能が正常に動作する', async () => {
      let callCount = 0;
      mockTaskService.fetchTasks.mockImplementation(() => {
        callCount++;
        if (callCount < 3) {
          return Promise.reject(new Error('Temporary failure'));
        }
        return Promise.resolve(mockTasks);
      });

      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null, { retryCount: 3 })
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(callCount).toBe(3);
      expect(result.current.tasks).toEqual(mockTasks);
      expect(result.current.error).toBeNull();
    });

    it('最大リトライ回数に達した場合エラーが保持される', async () => {
      mockTaskService.fetchTasks.mockRejectedValue(new Error('Persistent failure'));

      const { result } = renderHook(() =>
        useOptimizedTasks(mockUser.id, null, { retryCount: 2 })
      );

      await waitFor(() => {
        expect(result.current.loading).toBe(false);
      });

      expect(result.current.error).toBe('Persistent failure');
      expect(mockTaskService.fetchTasks).toHaveBeenCalledTimes(3); // 初回 + 2回リトライ
    });
  });
});