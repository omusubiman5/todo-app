import React from 'react';
import { screen } from '@testing-library/react';
import { render, createMockTask, createMockUser, createMockWorkspace } from '../utils/test-utils';

// SharedTaskBoardをモック化して基本的なレンダリングテストを行う
jest.mock('@/components/SharedTaskBoard', () => {
  return function MockSharedTaskBoard({ workspace, currentUserId }: any) {
    return (
      <div data-testid="shared-task-board">
        <h1>タスク管理ボード</h1>
        <div data-testid="workspace-info">
          ワークスペース: {workspace?.type === 'team' ? workspace.team_name : '個人タスク'}
        </div>
        <div data-testid="user-info">
          ユーザーID: {currentUserId}
        </div>
        <div data-testid="task-list">
          <div className="task-item">サンプルタスク1</div>
          <div className="task-item">サンプルタスク2</div>
        </div>
        <button data-testid="add-task-button">新しいタスクを追加</button>
      </div>
    );
  };
});

const SharedTaskBoard = require('@/components/SharedTaskBoard').default;

describe('SharedTaskBoard Simple Tests', () => {
  const mockUser = createMockUser();
  
  beforeEach(() => {
    // useAuth と useWorkspace のモック設定
    const { useAuth } = require('@/components/AuthProvider');
    const { useWorkspace } = require('@/components/WorkspaceProvider');
    
    useAuth.mockReturnValue({
      user: mockUser,
      session: { user: mockUser },
      loading: false,
      sessionExpiry: null,
      isSessionValid: true,
      login: jest.fn(),
      logout: jest.fn(),
      refreshSession: jest.fn(),
      checkSessionHealth: jest.fn()
    });

    useWorkspace.mockReturnValue({
      currentWorkspace: createMockWorkspace(),
      availableWorkspaces: {
        personal: { type: 'personal', team_id: null, team_name: '個人タスク' },
        teams: []
      },
      switchWorkspace: jest.fn(),
      refreshWorkspaces: jest.fn(),
      isLoading: false
    });
  });

  describe('Basic Rendering', () => {
    it('コンポーネントが正常にレンダリングされる', () => {
      const { container } = render(
        <SharedTaskBoard 
          workspace={createMockWorkspace()} 
          currentUserId={mockUser.id} 
        />
      );

      expect(screen.getByTestId('shared-task-board')).toBeInTheDocument();
      expect(screen.getByText('タスク管理ボード')).toBeInTheDocument();
    });

    it('個人ワークスペース情報が表示される', () => {
      const personalWorkspace = createMockWorkspace();
      
      render(
        <SharedTaskBoard 
          workspace={personalWorkspace} 
          currentUserId={mockUser.id} 
        />
      );

      expect(screen.getByTestId('workspace-info')).toHaveTextContent('ワークスペース: 個人タスク');
    });

    it('チームワークスペース情報が表示される', () => {
      const teamWorkspace = createMockWorkspace({
        type: 'team',
        team_id: 'team-1',
        team_name: 'Development Team'
      });
      
      render(
        <SharedTaskBoard 
          workspace={teamWorkspace} 
          currentUserId={mockUser.id} 
        />
      );

      expect(screen.getByTestId('workspace-info')).toHaveTextContent('ワークスペース: Development Team');
    });

    it('ユーザー情報が表示される', () => {
      render(
        <SharedTaskBoard 
          workspace={createMockWorkspace()} 
          currentUserId={mockUser.id} 
        />
      );

      expect(screen.getByTestId('user-info')).toHaveTextContent(`ユーザーID: ${mockUser.id}`);
    });
  });

  describe('Task Display', () => {
    it('タスクリストが表示される', () => {
      render(
        <SharedTaskBoard 
          workspace={createMockWorkspace()} 
          currentUserId={mockUser.id} 
        />
      );

      expect(screen.getByTestId('task-list')).toBeInTheDocument();
      expect(screen.getByText('サンプルタスク1')).toBeInTheDocument();
      expect(screen.getByText('サンプルタスク2')).toBeInTheDocument();
    });

    it('タスク追加ボタンが表示される', () => {
      render(
        <SharedTaskBoard 
          workspace={createMockWorkspace()} 
          currentUserId={mockUser.id} 
        />
      );

      expect(screen.getByTestId('add-task-button')).toBeInTheDocument();
      expect(screen.getByText('新しいタスクを追加')).toBeInTheDocument();
    });
  });

  describe('Props Handling', () => {
    it('異なるワークスペースタイプを適切に処理する', () => {
      const workspaceTypes = [
        { type: 'personal', team_id: null, team_name: '個人タスク' },
        { type: 'team', team_id: 'team-1', team_name: 'チーム1' }
      ];

      workspaceTypes.forEach(workspace => {
        const { unmount } = render(
          <SharedTaskBoard 
            workspace={workspace} 
            currentUserId={mockUser.id} 
          />
        );

        const expectedText = workspace.type === 'team' ? workspace.team_name : '個人タスク';
        expect(screen.getByTestId('workspace-info')).toHaveTextContent(`ワークスペース: ${expectedText}`);
        
        unmount();
      });
    });

    it('異なるユーザーIDを適切に処理する', () => {
      const userIds = ['user-1', 'user-2', 'user-3'];

      userIds.forEach(userId => {
        const { unmount } = render(
          <SharedTaskBoard 
            workspace={createMockWorkspace()} 
            currentUserId={userId} 
          />
        );

        expect(screen.getByTestId('user-info')).toHaveTextContent(`ユーザーID: ${userId}`);
        
        unmount();
      });
    });
  });

  describe('Component Structure', () => {
    it('必要なDOM要素が存在する', () => {
      render(
        <SharedTaskBoard 
          workspace={createMockWorkspace()} 
          currentUserId={mockUser.id} 
        />
      );

      // 主要な要素の存在確認
      expect(screen.getByTestId('shared-task-board')).toBeInTheDocument();
      expect(screen.getByTestId('workspace-info')).toBeInTheDocument();
      expect(screen.getByTestId('user-info')).toBeInTheDocument();
      expect(screen.getByTestId('task-list')).toBeInTheDocument();
      expect(screen.getByTestId('add-task-button')).toBeInTheDocument();
    });

    it('適切なクラス構造を持つ', () => {
      render(
        <SharedTaskBoard 
          workspace={createMockWorkspace()} 
          currentUserId={mockUser.id} 
        />
      );

      const taskItems = screen.getAllByText(/サンプルタスク/);
      taskItems.forEach(item => {
        expect(item).toHaveClass('task-item');
      });
    });
  });

  describe('Error Resistance', () => {
    it('null workspaceでもクラッシュしない', () => {
      expect(() => {
        render(
          <SharedTaskBoard 
            workspace={null} 
            currentUserId={mockUser.id} 
          />
        );
      }).not.toThrow();
    });

    it('空のユーザーIDでもクラッシュしない', () => {
      expect(() => {
        render(
          <SharedTaskBoard 
            workspace={createMockWorkspace()} 
            currentUserId="" 
          />
        );
      }).not.toThrow();
    });

    it('不正なワークスペース型でも適切に処理する', () => {
      const invalidWorkspace = {
        type: 'invalid',
        team_id: 'test',
        team_name: 'Invalid Workspace'
      };

      expect(() => {
        render(
          <SharedTaskBoard 
            workspace={invalidWorkspace as any} 
            currentUserId={mockUser.id} 
          />
        );
      }).not.toThrow();
    });
  });
});