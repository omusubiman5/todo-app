{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:security": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.config.mjs",
    "lint:security-fix": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.config.mjs --fix",
    "security-check": "npm run lint:security && npm run audit",
    "security-check:critical": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.config.mjs --quiet",
    "security-audit": "npm audit --audit-level=high",
    "security-full": "npm run security-check && npm run security-audit && npm run type-check",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "audit": "npm audit --audit-level=moderate",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "db:optimize": "node scripts/apply-database-optimizations.js",
    "db:benchmark": "node scripts/benchmark-database.js",
    "db:verify": "node scripts/verify-database-indexes.js"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^1.12.1",
    "@sentry/nextjs": "^10.12.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.52.0",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-devtools": "^5.87.4",
    "lucide-react": "^0.542.0",
    "next": "^15.5.2",
    "qrcode": "^1.5.4",
    "qrcode-svg": "^1.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-window": "^2.0.2",
    "recharts": "^3.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run security-check:critical",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@next/bundle-analyzer": "^15.5.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.2.1",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-react-hooks-addons": "^0.5.0",
    "eslint-plugin-react-security": "^0.1.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-xss": "^0.1.12",
    "husky": "^9.1.7",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lightningcss": "^1.30.1",
    "lint-staged": "^16.1.6",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.1",
    "typescript": "^5"
  }
}
